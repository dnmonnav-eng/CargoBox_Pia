    "/paquetes/{guia}/incidencias": {
      "post": {
        "summary": "Registrar Incidencia Entrega",
        "description": "Escribe la incidencia. Opciones válidas:\n- 'direccion_incorrecta' \n- 'paquete_danado' \n- 'perdida' \n- 'rechazo'",
        "operationId": "registrar_incidencia_entrega_paquetes__guia__incidencias_post",
        "parameters": [
          {
            "name": "guia",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Guia"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {

  "components": {
    "schemas": {
      "EntregaRequest": {
        "properties": {
          "evidencia": {
            "type": "string",
            "title": "Evidencia",
            "description": "Escribe la evidencia (Firma digital / Fotografía del paquete)"
          }
        },
        "type": "object",
        "required": [
          "evidencia"
        ],
        "title": "EntregaRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidenciaRequest": {
        "properties": {
          "tipo_incidencia": {
            "type": "string",
            "title": "Tipo Incidencia",
            "description": "Escribe EXACTAMENTE una de estas opciones: 'direccion_incorrecta', 'paquete_danado', 'perdida', 'rechazo'"
          }
        },
        "type": "object",
        "required": [
          "tipo_incidencia"
        ],
        "title": "IncidenciaRequest"
      },
      "RegistroPaqueteRequest": {
        "properties": {
          "peso_kg": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Peso Kg"
          },
          "largo_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Largo M"
          },
          "ancho_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Ancho M"
          },
          "alto_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Alto M"
          },
          "telefono_cliente": {
            "type": "string",
            "pattern": "^\\d{10}$",
            "title": "Telefono Cliente"
          }
        },
        "type": "object",
        "required": [
          "peso_kg",
          "largo_m",
          "ancho_m",
          "alto_m",
          "telefono_cliente"
        ],
        "title": "RegistroPaqueteRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}